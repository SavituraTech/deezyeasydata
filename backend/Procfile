web: python manage.py collectstatic --noinput && python manage.py migrate && sh -c 'python manage.py process_payvessel_webhooks --loop 60 & exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 1 --threads 4 --max-requests 1000 --max-requests-jitter 100 --timeout 120 --access-logfile - --error-logfile -'
