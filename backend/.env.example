# Django
SECRET_KEY=your-secret-key-here-min-50-chars-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For production, point this to your Postgres instance, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=sqlite:///db.sqlite3

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=10080

# CORS (comma-separated for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (password reset links, redirects)
FRONTEND_URL=http://localhost:3000

# Wallet & transaction limits
MIN_WALLET_BALANCE=0
MAX_TRANSACTION_AMOUNT=50000
CURRENCY=NGN

# PayVessel (wallet funding and virtual accounts)
PAYVESSEL_BASE_URL=https://api.payvessel.com
PAYVESSEL_API_KEY=your-payvessel-api-key
PAYVESSEL_SECRET=your-payvessel-api-secret
PAYVESSEL_BUSINESS_ID=your-payvessel-business-id
PAYVESSEL_WEBHOOK_SECRET=your-payvessel-webhook-secret
PAYVESSEL_BANK_CODES=120001,999991
PAYVESSEL_ACCOUNT_TYPE=STATIC
# Official PayVessel webhook source addresses. Keep enforcement enabled in production.
PAYVESSEL_TRUSTED_IPS=3.255.23.38,162.246.254.36
PAYVESSEL_ENFORCE_IP_ALLOWLIST=True
# Verify Payment returns amounts in the smallest currency unit (kobo).
PAYVESSEL_VERIFY_AMOUNT_IN_KOBO=True

# External Provider (Newdatasub)
NEWDATASUB_API_KEY=your-api-key-here
NEWDATASUB_BASE_URL=https://newdatasub.com/autobiz_vending_index.php
# Optional: comma-separated actions to try for `manage.py sync_newdatasub_products`
# NEWDATASUB_SYNC_ACTIONS=get_available_services
